{
  "query": {
    "bool": {
      "should": [
        {
          "nested": {
            "path": "albums",
            "query": {
              "bool": {
                "filter": [
                  {
                    "term": {
                      "albums.type": "Vinyl"
                    }
                  }
                ],
                "must": [
                  {
                    "bool": {
                      "should": [
                        {
                          "match_phrase": {
                            "albums.album": {
                              "query": "By Storm - My Ghosts Go Ghost",
                              "slop": 2,
                              "boost": 6
                            }
                          }
                        },
                        {
                          "match": {
                            "albums.album": {
                              "query": "By Storm - My Ghosts Go Ghost",
                              "fuzziness": "AUTO",
                              "prefix_length": 2,
                              "max_expansions": 20,
                              "minimum_should_match": "2<100% 5<85%",
                              "boost": 2
                            }
                          }
                        }
                      ],
                      "minimum_should_match": 1
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "nested": {
            "path": "artists",
            "query": {
              "bool": {
                "should": [
                  {
                    "match_phrase": {
                      "artists.artist": {
                        "query": "By Storm",
                        "slop": 1,
                        "boost": 4
                      }
                    }
                  },
                  {
                    "match": {
                      "artists.artist": {
                        "query": "By Storm",
                        "fuzziness": "AUTO",
                        "prefix_length": 2,
                        "max_expansions": 20,
                        "minimum_should_match": "100%",
                        "boost": 1
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        },
        {
          "bool": {
            "should": [
              {
                "match_phrase": {
                  "custom": {
                    "query": "By Storm My Ghosts Go Ghost",
                    "slop": 2,
                    "boost": 5
                  }
                }
              },
              {
                "match": {
                  "custom": {
                    "query": "By Storm My Ghosts Go Ghost",
                    "fuzziness": "AUTO",
                    "prefix_length": 2,
                    "max_expansions": 20,
                    "minimum_should_match": "2<100% 5<85%",
                    "boost": 1
                  }
                }
              }
            ],
            "minimum_should_match": 1
          }
        },
        {
          "term": {
            "genres": "Hip Hop"
          }
        }
      ],
      "minimum_should_match": 1
    }
  }
}
